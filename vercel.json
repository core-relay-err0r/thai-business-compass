{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/149e9513-01fa-4fb0-aad4-566afd725d1b/2d206a39-8ed7-437e-a3be-862e0f06eea3/a-4-a/c.js",
      "destination": "https://api.vercel.com/bot-protection/v1/challenge"
    },
    {
      "source": "/149e9513-01fa-4fb0-aad4-566afd725d1b/2d206a39-8ed7-437e-a3be-862e0f06eea3/:path*",
      "destination": "https://api.vercel.com/bot-protection/v1/proxy/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/corporate",
      "destination": "/services#corporate",
      "permanent": true
    },
    {
      "source": "/corporate-services",
      "destination": "/services#corporate",
      "permanent": true
    },
    {
      "source": "/accounting",
      "destination": "/services#accounting",
      "permanent": true
    },
    {
      "source": "/cost-calculator",
      "destination": "/services#accounting",
      "permanent": true
    },
    {
      "source": "/consulting",
      "destination": "/services#consulting",
      "permanent": true
    },
    {
      "source": "/terms",
      "destination": "/tos",
      "permanent": true
    }
  ]
}
